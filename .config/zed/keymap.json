[
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      "space f f": "file_finder::Toggle",
      "space e e": "workspace::ToggleLeftDock",
      "space e f": "workspace::ToggleLeftDock",
      "space s h": "pane::SplitDown",
      "space s v": "pane::SplitLeft",
      "space s x": "pane::CloseActiveItem",
      "space f s": "chat_panel::ToggleFocus",
      "space c a": "editor::ToggleCodeActions",
      "ctrl-]": "terminal_panel::ToggleFocus",
      "ctrl-h": ["workspace::ActivatePaneInDirection", "Left"],
      "ctrl-l": ["workspace::ActivatePaneInDirection", "Right"],
      "ctrl-k": ["workspace::ActivatePaneInDirection", "Up"],
      "ctrl-j": ["workspace::ActivatePaneInDirection", "Down"],
      "ctrl-.": "pane::ActivateNextItem",
      "ctrl-,": "pane::ActivatePrevItem"
    }
  },
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      "j j": "vim::NormalBefore"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-]": "workspace::ToggleBottomDock",
      "ctrl-h": ["workspace::ActivatePaneInDirection", "Left"],
      "ctrl-l": ["workspace::ActivatePaneInDirection", "Right"],
      "ctrl-k": ["workspace::ActivatePaneInDirection", "Up"],
      "ctrl-j": ["workspace::ActivatePaneInDirection", "Down"]
    }
  },
  {
    "context": "!Terminal && vim_mode != normal",
    "bindings": {
      "ctrl-j": ["workspace::SendKeystrokes", "down"],
      "ctrl-k": ["workspace::SendKeystrokes", "up"]
    }
  },
  {
    "context": "menu",
    "bindings": {
      "ctrl-j": ["workspace::SendKeystrokes", "down"],
      "ctrl-k": ["workspace::SendKeystrokes", "up"]
    }
  },
  {
    "context": "Dock",
    "bindings": {
      "space e f": "workspace::ToggleLeftDock",
      "space e e": "workspace::CloseAllDocks",
      "ctrl-h": ["workspace::ActivatePaneInDirection", "Left"],
      "ctrl-l": ["workspace::ActivatePaneInDirection", "Right"],
      "ctrl-k": ["workspace::ActivatePaneInDirection", "Up"],
      "ctrl-j": ["workspace::ActivatePaneInDirection", "Down"],
      "a": "project_panel::NewFile",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "x": "project_panel::Trash"
    }
  }
]
